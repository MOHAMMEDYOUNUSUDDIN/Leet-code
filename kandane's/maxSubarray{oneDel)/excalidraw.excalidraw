    {
      "id": "xJcMKhQ_AeTQgDESCiEFc",
      "type": "text",
      "x": 1084.4445868598089,
      "y": 861.8999543931751,
      "width": 511.1397705078125,
      "height": 1675,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bF7",
      "roundness": null,
      "seed": 1558225745,
      "version": 892,
      "versionNonce": 1238983185,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790614512102,
      "created": 1790612728006,
      "link": null,
      "locked": false,
      "text": "\n\nDry Run :\n\nEx : [1,-2,0,3]\n\n//start of code\n\nnoDel =a[o]=>1 =>-1\noneDel=\nres = 1,\n\n_____________________________\n\nfor loop { //a[1]=-2\nprevNoDel = noDel(1)\n\na[1]\nnoDel = max{ a[i] , nodel +a[i]}\n                 -2  ,  1+-2 \n// noDel = -1\n\nonedel=max{1,1-2}\n //oneDel =1;\n\nres = Max{res ,max{ondel,onedel}}\n//res =1;\n}\n \n______________________________\n\nfor loop { //a[2]=0\nprevNoDel = noDel(-1)\n\na[2]\nnoDel = max{ a[i] , nodel +a[i]}\n                 0  ,  -1+0\n// nodel = 0\n\nonedel=max{prevdel,onedel+a[i]}\n                -1,      1+0 // this worked so 2 deleted\n //pneDel =1;\n\nres = Max{res ,max{ondel,onedel}}\n//res =1;\n}\n\n______________________________\n\nfor loop { //a[3]=3\nprevNoDel = noDel(0)\n\na[3]\nnoDel = max{ a[i] , nodel +a[i]}\n                 3  ,  0+3\n// nodel = 3\n\nonedel=max{prevdel,onedel+a[i]}\n               0,      1+3\n //pneDel =4;\n\nres = Max{res ,max{ondel,onedel}}\n//res =4;\n}\n\n\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "\n\nDry Run :\n\nEx : [1,-2,0,3]\n\n//start of code\n\nnoDel =a[o]=>1 =>-1\noneDel=\nres = 1,\n\n_____________________________\n\nfor loop { //a[1]=-2\nprevNoDel = noDel(1)\n\na[1]\nnoDel = max{ a[i] , nodel +a[i]}\n                 -2  ,  1+-2 \n// noDel = -1\n\nonedel=max{1,1-2}\n //oneDel =1;\n\nres = Max{res ,max{ondel,onedel}}\n//res =1;\n}\n \n______________________________\n\nfor loop { //a[2]=0\nprevNoDel = noDel(-1)\n\na[2]\nnoDel = max{ a[i] , nodel +a[i]}\n                 0  ,  -1+0\n// nodel = 0\n\nonedel=max{prevdel,onedel+a[i]}\n                -1,      1+0 // this worked so 2 deleted\n //pneDel =1;\n\nres = Max{res ,max{ondel,onedel}}\n//res =1;\n}\n\n______________________________\n\nfor loop { //a[3]=3\nprevNoDel = noDel(0)\n\na[3]\nnoDel = max{ a[i] , nodel +a[i]}\n                 3  ,  0+3\n// nodel = 3\n\nonedel=max{prevdel,onedel+a[i]}\n               0,      1+3\n //pneDel =4;\n\nres = Max{res ,max{ondel,onedel}}\n//res =4;\n}\n\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
