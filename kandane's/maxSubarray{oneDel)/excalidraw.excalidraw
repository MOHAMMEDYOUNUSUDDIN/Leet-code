      "updated": 1790612680302,
      "link": null,
      "locked": false,
      "text": "class Solution {\n    public double findMaxAverage(int[] nums, int k) {\n        int max_sum = 0;\n        int current_sum = 0;\n        for (int i=0;i<k;i++){\n            current_sum +=nums[i];\n        }\n        max_sum=current_sum;\n    }\n}",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "class Solution {\n    public double findMaxAverage(int[] nums, int k) {\n        int max_sum = 0;\n        int current_sum = 0;\n        for (int i=0;i<k;i++){\n            current_sum +=nums[i];\n        }\n        max_sum=current_sum;\n    }\n}",
      "autoResize": true,
      "lineHeight": 1.25,
      "created": null,
      "labelPosition": null,
      "baseFontSize": null
    },
