    {
      "id": "-Tn_QLzycdDReiB5zjtNG",
      "type": "text",
      "x": 11458.38386073562,
      "y": 1583.2553959716377,
      "width": 286.31982421875,
      "height": 100,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bF2",
      "roundness": null,
      "seed": 113779750,
      "version": 94,
      "versionNonce": 1108351537,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1790612680303,
      "created": 1790362248219,
      "link": null,
      "locked": false,
      "text": "maxend = max(v1,max(v2,v3));\nminend=min(v1,min(v2,v3));\nres(res,max(minend,maxend));\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "maxend = max(v1,max(v2,v3));\nminend=min(v1,min(v2,v3));\nres(res,max(minend,maxend));\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "b2rmc66aOkAKCF91QkgHh",
      "type": "text",
      "x": 357.6000061035156,
      "y": 985.6333190917968,
      "width": 523.9397583007812,
      "height": 450,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bF3",
      "roundness": null,
      "seed": 1021155711,
      "version": 4,
      "versionNonce": 375692177,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1790612689094,
      "created": 1790612684550,
      "link": null,
      "locked": false,
      "text": "public int maximumSum(int[] a) { \n    int n = a.length; \n    int noDel = a[0]; \n    int oneDel = Integer.MIN_VALUE; \n    int res = a[0]; \n \n    for (int i = 1; i < n; i++) { \n        int prevNoDel = noDel; \n \n        noDel = Math.max(a[i], noDel + a[i]); \n \n        oneDel = Math.max(prevNoDel, oneDel + a[i]); \n \n        res = Math.max(res, Math.max(noDel, oneDel)); \n    } \n \n    return res; \n} ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "public int maximumSum(int[] a) { \n    int n = a.length; \n    int noDel = a[0]; \n    int oneDel = Integer.MIN_VALUE; \n    int res = a[0]; \n \n    for (int i = 1; i < n; i++) { \n        int prevNoDel = noDel; \n \n        noDel = Math.max(a[i], noDel + a[i]); \n \n        oneDel = Math.max(prevNoDel, oneDel + a[i]); \n \n        res = Math.max(res, Math.max(noDel, oneDel)); \n    } \n \n    return res; \n} ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
